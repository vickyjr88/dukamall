# Copy to .env and fill in. Never commit .env - it is gitignored.

# --- Database ---------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@db:5432/shops_platform
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=shops_platform

# --- Auth -------------------------------------------------------------------
# Required. Generate with: openssl rand -hex 32
JWT_SECRET=

# Encrypts secrets stored in the database (shops' Paystack keys, the SMTP
# password, admin two-factor seeds). Generate with: openssl rand -base64 32
# KEEP THIS SAFE and back it up separately from the database: losing it makes
# those stored secrets unreadable (shops would need to re-enter their keys).
# Existing plaintext values are encrypted automatically on the next start.
SECRETS_ENCRYPTION_KEY=

# Serve the Swagger UI at /api-docs. Leave off in production.
ENABLE_API_DOCS=false

# true = every platform admin must set up two-factor sign-in before using the console.
ADMIN_REQUIRE_2FA=false

# --- API URL ----------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:3211
INTERNAL_API_BASE_URL=http://backend:3200

# --- Platform domain ---------------------------------------------------------
# Every shop without a custom domain gets "<slug>.PLATFORM_DOMAIN" as its
# storefront. In local dev this can stay as a bare hostname the /etc/hosts
# file maps to 127.0.0.1 (e.g. add "127.0.0.1 nairobigents.localhost" and set
# this to "localhost:3203"), and in production the real apex domain the
# platform is hosted under, e.g. dukamall.app.
PLATFORM_DOMAIN=localhost:3203
NEXT_PUBLIC_PLATFORM_DOMAIN=localhost:3203

# --- Object storage (MinIO) -------------------------------------------------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_BUCKET=shops-platform-media
# Public base URL uploaded media is served from -- the API's own public
# address, since images are streamed by the backend at /media/:shopId/:key.
MEDIA_PUBLIC_BASE_URL=http://localhost:3211

# Redis, backing BullMQ (abandoned-cart reminders, once built).
REDIS_URL=redis://redis:6379

# --- Published host ports ---------------------------------------------------
# Deliberately a distinct block from drip-crm's own ports (3003/3004/3101/
# 3102/etc.) so both stacks can run on the same host without colliding.
WEB_PORT=3203
API_PORT=3211
# Rolling-deploy standby slot -- see scripts/deploy.sh and docs/DEPLOYMENT.md.
WEB_PORT2=3204
API_PORT2=3212
DB_PORT=15533
REDIS_PORT=16580
MINIO_HOST_PORT=19102
MINIO_CONSOLE_HOST_PORT=19103
