{
  "name": "shops-platform-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Backend for the Dubai Merchants Shops Platform",
  "main": "dist/main.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/main.ts",
    "build": "tsc",
    "start": "node dist/main.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:seed": "node prisma/seed.js",
    "seed": "npm run prisma:seed",
    "sync:drip-emporium": "ts-node scripts/sync-drip-emporium-feed.ts",
    "create:super-admin": "ts-node scripts/create-super-admin.ts",
    "test": "jest",
    "test:int": "jest -c jest.int.config.js",
    "test:all": "jest && jest -c jest.int.config.js"
  },
  "dependencies": {
    "@nestjs/bullmq": "^11.0.5",
    "@nestjs/common": "^10.3.5",
    "@nestjs/core": "^10.3.5",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^10.3.5",
    "@nestjs/swagger": "^7.3.0",
    "@nestjs/throttler": "^6.7.1",
    "@prisma/client": "5.22.0",
    "bcrypt": "^6.0.0",
    "bullmq": "^6.0.10",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "ioredis": "^6.0.0",
    "libphonenumber-js": "^1.13.12",
    "minio": "^8.0.7",
    "nodemailer": "^10.0.13",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.1.13",
    "swagger-ui-express": "^5.0.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/jest": "^29.5.14",
    "@types/nodemailer": "^8.0.2",
    "@types/passport-jwt": "^4.0.1",
    "jest": "^29.7.0",
    "prisma": "5.22.0",
    "ts-jest": "^29.4.14",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.6.2"
  }
}
