// Dubai Merchants Shops Platform -- trimmed, multi-tenant commerce schema.
//
// Deliberately NOT a port of drip-crm's full schema. Per the platform design
// doc, accounting, payroll, HR, fixed assets and bank reconciliation are out
// of scope entirely -- fifty independent stallholders need a stock count and
// a sales tally, not a general ledger. Every tenant-owned model below carries
// a `shopId` and every previously-global unique constraint (sku, slug, order
// number) is scoped to (shopId, ...) instead, since fifty shops will
// otherwise collide on the first shared SKU or slug.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Tenant root
// ---------------------------------------------------------------------------

enum ShopStatus {
  TRIAL
  ACTIVE
  SUSPENDED
}

/// Manual billing tier, not a payment-gateway-driven subscription -- see
/// Shop.billingPlan's own comment.
enum BillingPlan {
  TRIAL
  BASIC
  PRO
}

model Shop {
  id           String     @id @default(cuid())
  slug         String     @unique
  name         String
  customDomain String?    @unique
  status       ShopStatus @default(TRIAL)

  // Custom-domain verification (design doc Phase 3). A domain sits here,
  // unverified and doing nothing, until DomainVerificationService confirms
  // the owner controls it via a DNS TXT lookup -- ONLY then is it copied
  // into customDomain above, the field resolveByHost() actually trusts.
  // Never promote pendingDomain -> customDomain without that check: it's
  // the only thing standing between "any shop owner can type in a domain
  // form" and a shop hijacking traffic meant for a business it doesn't own.
  pendingDomain           String?
  domainVerificationToken String?
  domainVerifiedAt        DateTime?

  whatsappNumber         String?
  paystackSecretKey      String?
  paystackPublicKey      String?
  currency               String  @default("KES")
  orderPrefix            String  @default("SHP")

  // Manual billing tracking, not a payment gateway integration -- an
  // operator marks a shop paid after an offline transaction (bank
  // transfer, M-Pesa) and records it here. trialEndsAt is nullable and set
  // by hand rather than derived from createdAt + a fixed window, since an
  // operator needs to extend it (a support courtesy, a sales negotiation)
  // without that meaning "re-create the shop."
  billingPlan  BillingPlan @default(TRIAL)
  trialEndsAt  DateTime?
  billingNotes String?

  // Where new-order and new-lead alerts go. Null means every OWNER of the shop.
  notificationEmail   String?
  // Flat delivery charge added at checkout, waived when the order (after any
  // discount) reaches freeDeliveryOverKes. No zones or weights: a single flat
  // fee is what a shop this size can actually quote.
  deliveryFeeKes      Decimal  @default(0) @db.Decimal(12, 2)
  freeDeliveryOverKes Decimal? @db.Decimal(12, 2)

  // Storefront copy the merchant controls (portal "Store info"). All optional:
  // the storefront falls back to sensible defaults, and anything left empty is
  // simply not rendered.
  tagline        String? // footer blurb under the shop name
  announcement   String? // slim bar above the header ("Free delivery over KES 5,000")
  seoDescription String? // home page meta description / link-preview text
  contactEmail   String?
  contactPhone   String?
  address        String?
  openingHours   String?
  instagramUrl   String?
  facebookUrl    String?
  tiktokUrl      String?

  theme         ShopTheme?
  pages         ShopPage[]
  staff         UserShop[]
  products      Product[]
  categories    ProductCategory[]
  customers     Customer[]
  orders        Order[]
  cartLeads     CartLead[]
  pageContents  PageContent[]
  adminAuditLog AdminAuditLog[]
  discounts     Discount[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Tier 1 token theming -- see design doc S:1.4. Deliberately just a handful
// of scalar fields, not a page-builder document: the platform ships a
// curated set of font pairings and layout presets, a shop picks from them.
model ShopTheme {
  id           String @id @default(cuid())
  shopId       String @unique
  shop         Shop   @relation(fields: [shopId], references: [id], onDelete: Cascade)

  primaryColor String @default("#2438a8")
  accentColor  String @default("#0f7a40")
  logoUrl      String?
  /// Home page hero background photo, uploaded via the portal's media
  /// upload endpoint (same one products already use) -- optional, since the
  /// hero already renders correctly with just the shop name over a plain
  /// surface color when unset (see globals.css's .shop-hero-content, which
  /// has no .has-media modifier in that case).
  heroImageUrl String?
  /// Home hero copy. Null falls back to the defaults the storefront shipped
  /// with ("New arrivals" / shop name / "Shop the latest drop..." / "Shop now").
  heroEyebrow     String?
  heroHeadline    String?
  heroSubtitle    String?
  heroButtonLabel String?
  fontPairing  String @default("fraunces-manrope")
  layoutPreset String @default("sharp")

  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Platform staff & auth
// ---------------------------------------------------------------------------

// Global identity so one person (e.g. a family running two stalls) can log in
// once and switch between shops, rather than holding a separate account per
// shop. What they can do in a given shop is entirely determined by their
// UserShop row for it, never by this table.
model User {
  id            String          @id @default(cuid())
  email         String          @unique
  passwordHash  String
  firstName     String
  lastName      String
  isSuperAdmin  Boolean         @default(false)
  shops         UserShop[]
  adminAuditLog AdminAuditLog[]
  createdAt     DateTime        @default(now())
}

/// One shared reset-token table for all three login kinds this platform has
/// (staff/admin User rows, and Customer rows) rather than three near-
/// identical tables -- accountKind distinguishes which table accountId
/// points into, since a raw foreign key can't reference "User or Customer"
/// directly. A staff member and a platform admin are both User rows (the
/// only difference is isSuperAdmin), so "STAFF" here covers both; the
/// request/confirm flow itself doesn't need to know which one it is until
/// the password is actually written back.
enum PasswordResetAccountKind {
  STAFF
  CUSTOMER
}

model PasswordResetToken {
  id          String                   @id @default(cuid())
  accountKind PasswordResetAccountKind
  accountId   String
  // SHA-256 of the actual token, never the token itself -- the emailed
  // link's token is the only place the real value ever exists in plain
  // form, the same "never store what you'd hand to an attacker who reads
  // the database" reasoning as a password hash.
  tokenHash   String                   @unique
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime                 @default(now())

  @@index([accountKind, accountId])
}

enum ShopRole {
  OWNER
  STAFF
}

model UserShop {
  userId String
  shopId String
  role   ShopRole @default(STAFF)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([userId, shopId])
}

// ---------------------------------------------------------------------------
// Catalog
// ---------------------------------------------------------------------------

model ProductCategory {
  id       String  @id @default(cuid())
  shopId   String
  shop     Shop    @relation(fields: [shopId], references: [id], onDelete: Cascade)
  name     String
  slug     String
  isActive Boolean @default(true)

  products Product[]

  @@unique([shopId, slug])
}

model Product {
  id          String   @id @default(cuid())
  shopId      String
  shop        Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)

  categoryId  String?
  category    ProductCategory? @relation(fields: [categoryId], references: [id])

  name        String
  slug        String
  description String?
  brand       String?
  imageUrls   Json     @default("[]")
  isActive    Boolean  @default(true)
  isFeatured  Boolean  @default(false)

  // Optional overrides for how the product appears in Google and link
  // previews; empty falls back to the product name / description.
  seoTitle       String?
  seoDescription String?

  // Set only for a product created by scripts/sync-drip-emporium-feed.ts,
  // holding that feed's item_group_id -- the sync's find-key for "have I
  // already created this product" on a re-run, and the one thing that
  // distinguishes a synced product from one a shop owner typed in by hand
  // via the portal. NULL here means "hands off, sync must never touch this
  // row" -- see that script's own header comment for why this boundary
  // exists.
  syncSourceId String?

  variants    ProductVariant[]
  favorites   Favorite[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([shopId, slug])
  @@unique([shopId, syncSourceId])
}

// No StockMovement ledger -- stockOnHand is a plain counter, decremented on a
// paid order line and adjusted directly by the shop owner. See design doc
// S:2.3 ("Stock tally and sales tally, in place of accounting").
model ProductVariant {
  id         String  @id @default(cuid())
  productId  String
  product    Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  sku        String
  name       String
  size       String?
  attributes Json    @default("{}")
  priceKes   Decimal @db.Decimal(12, 2)
  wasPriceKes Decimal? @db.Decimal(12, 2)
  stockOnHand Int    @default(0)
  isActive   Boolean @default(true)

  // Merchant-controlled display order (EUR 40 before EUR 41, S before M) --
  // sizes don't sort sensibly by name alone, and the storefront previously
  // loaded variants with no orderBy at all. Ties (every variant created
  // before this column existed has 0) fall back to creation order.
  position   Int     @default(0)

  orderLines OrderLine[]
  cartLeadLines CartLeadLine[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, sku])
}

// ---------------------------------------------------------------------------
// Customers
// ---------------------------------------------------------------------------

// Scoped to one shop, not shared across the platform -- a shopper at shop A
// has no account at shop B. See design doc S:2.4 for why this is deliberate.
model Customer {
  id           String   @id @default(cuid())
  shopId       String
  shop         Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)

  firstName    String?
  lastName     String?
  email        String?
  phone        String?
  passwordHash String?

  orders    Order[]
  favorites Favorite[]
  cartLeads CartLead[]

  createdAt DateTime @default(now())

  @@unique([shopId, email])
}

model Favorite {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([customerId, productId])
}

// ---------------------------------------------------------------------------
// Orders & checkout
// ---------------------------------------------------------------------------

enum OrderStatus {
  PENDING
  PAID
  CANCELLED
}

/// Where the goods are, kept apart from OrderStatus (which is about payment).
/// An order is PAID long before it is delivered, and the stock logic keys off
/// payment, so the two are separate fields rather than one overloaded status.
enum FulfilmentStatus {
  UNFULFILLED
  SHIPPED
  DELIVERED
}

/// How an order reached the shop. WHATSAPP and IN_PERSON are sales a merchant
/// records by hand -- until orders could be created from the portal those
/// never became orders at all, so stock, revenue and customers missed them.
enum OrderSource {
  WEBSITE
  WHATSAPP
  IN_PERSON
  OTHER
}

enum PaymentMethod {
  PAYSTACK
  CASH
  MPESA
  BANK_TRANSFER
  OTHER
}

model Order {
  id         String      @id @default(cuid())
  shopId     String
  shop       Shop        @relation(fields: [shopId], references: [id], onDelete: Cascade)
  customerId String?
  customer   Customer?   @relation(fields: [customerId], references: [id])

  // Human-facing, unique per shop, not globally -- prefixed with the shop's
  // own orderPrefix (see Shop.orderPrefix) rather than a hardcoded brand code.
  orderNumber String
  status      OrderStatus @default(PENDING)

  firstName       String
  lastName        String
  email           String?
  phone           String?
  shippingAddress String?

  subtotalKes Decimal @db.Decimal(12, 2)
  shippingKes Decimal @db.Decimal(12, 2) @default(0)
  // The amount actually subtracted by discountId below, kept alongside the
  // code's own percentOff/amountOffKes rather than only re-derived from
  // them -- a discount's terms can change or the code can be deleted after
  // the fact (see Discount.isActive), but an order's own receipt must keep
  // showing what was actually discounted at the time.
  discountKes Decimal @db.Decimal(12, 2) @default(0)
  totalKes    Decimal @db.Decimal(12, 2)

  discountId String?
  discount   Discount? @relation(fields: [discountId], references: [id], onDelete: SetNull)

  paystackReference String?

  fulfilmentStatus FulfilmentStatus @default(UNFULFILLED)
  shippedAt        DateTime?
  deliveredAt      DateTime?
  // Courier, waybill number, "left with the rider" -- free text, since what a
  // small shop tells its customer here varies too much for fixed fields.
  trackingNote     String?

  source           OrderSource @default(WEBSITE)
  // Null on an unpaid order. An online order that predates this column has a
  // paystackReference and no paymentMethod; readers treat that as PAYSTACK.
  paymentMethod    PaymentMethod?
  // M-Pesa code, bank reference, receipt number -- whatever lets the merchant
  // find the money again. (paystackReference above stays for Paystack.)
  paymentReference String?
  paidAt           DateTime?
  // The staff member who recorded a manual order; null for a customer's own.
  createdByUserId  String?

  notes OrderNote[]
  lines OrderLine[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([shopId, orderNumber])
}

// ---------------------------------------------------------------------------
// Discounts
// ---------------------------------------------------------------------------

enum DiscountType {
  PERCENT
  FIXED_AMOUNT
}

/// A shop-wide code, not per-product or per-category targeting -- see this
/// batch's own scoping note. Exactly one of percentOff/amountOffKes is set,
/// matching `type`; kept as two nullable columns rather than a single
/// polymorphic "value" column so a query can filter/sort on either without
/// a cast, and so the constraint (checked in service code, not the DB) is
/// visible directly in the shape of the row.
model Discount {
  id     String @id @default(cuid())
  shopId String
  shop   Shop   @relation(fields: [shopId], references: [id], onDelete: Cascade)

  // Always stored upper-cased -- see DiscountService's own note on why
  // matching is case-insensitive-by-normalization rather than a DB-level
  // citext column this platform doesn't otherwise use.
  code String

  type           DiscountType
  percentOff     Int?    @db.SmallInt
  amountOffKes   Decimal? @db.Decimal(12, 2)
  minOrderKes    Decimal? @db.Decimal(12, 2)

  expiresAt    DateTime?
  // Null = unlimited redemptions. Distinct from isActive: a code can be
  // manually turned off (isActive: false) independent of whether it's hit
  // its own usage cap.
  usageLimit   Int?
  isActive     Boolean @default(true)

  orders      Order[]
  redemptions DiscountRedemption[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([shopId, code])
}

/// One row per successful use -- gives usageLimit something to count
/// against without re-deriving it from Order.discountId every time (an
/// order can in principle be cancelled without that un-counting a
/// redemption; the code was genuinely used at checkout regardless of what
/// happens to the order afterward).
model DiscountRedemption {
  id         String   @id @default(cuid())
  discountId String
  discount   Discount @relation(fields: [discountId], references: [id], onDelete: Cascade)
  orderId    String   @unique
  createdAt  DateTime @default(now())
}

model OrderLine {
  id        String         @id @default(cuid())
  orderId   String
  order     Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id])

  quantity Int
  priceKes Decimal @db.Decimal(12, 2)
}

/// A merchant's internal note on an order ("customer will collect Friday",
/// "size swapped to 43") -- never shown to the customer. authorName is stored
/// rather than joined so a note still reads correctly after its author leaves.
model OrderNote {
  id         String   @id @default(cuid())
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  authorName String
  text       String
  createdAt  DateTime @default(now())

  @@index([orderId])
}

// ---------------------------------------------------------------------------
// WhatsApp / cart leads
// ---------------------------------------------------------------------------

enum CartLeadSource {
  WHATSAPP_ORDER
  ABANDONED_CART
}

/// Where a lead is in the merchant's follow-up. CONVERTED is set when an order
/// is created from it (convertedOrderId); the rest are the merchant's own.
enum LeadStatus {
  NEW
  CONTACTED
  CONVERTED
  LOST
}

model CartLead {
  id         String         @id @default(cuid())
  shopId     String
  shop       Shop           @relation(fields: [shopId], references: [id], onDelete: Cascade)
  customerId String?
  customer   Customer?      @relation(fields: [customerId], references: [id])

  source CartLeadSource

  customerName    String?
  customerPhone   String?
  customerEmail   String?
  shippingAddress String?
  message         String?

  status           LeadStatus @default(NEW)
  // The order created from this lead. A plain id, not a relation: the lead
  // outlives the order's deletion rules and the link is only ever read.
  convertedOrderId String?

  lines CartLeadLine[]

  createdAt DateTime @default(now())
}

model CartLeadLine {
  id         String          @id @default(cuid())
  cartLeadId String
  cartLead   CartLead        @relation(fields: [cartLeadId], references: [id], onDelete: Cascade)

  // Optional: a customer-typed size with no matching variant has neither --
  // see drip-crm's own CartLeadLineDto for the precedent this follows.
  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id])

  name         String
  size         String
  quantity     Int
  priceKes     Decimal @db.Decimal(12, 2)
  isCustomSize Boolean @default(false)
}

// ---------------------------------------------------------------------------
// Platform operator (admin console)
// ---------------------------------------------------------------------------

/// One row per mutating admin action (a status change, an impersonation) --
/// the operator console had no record of who did what or why until this;
/// setStatus() used to silently flip a shop to SUSPENDED with nothing to
/// show for it later. shopId is nullable (not every future admin action
/// will be shop-scoped) and onDelete: SetNull so a log entry outlives the
/// shop it was about, once shop deletion exists (a later batch).
model AdminAuditLog {
  id      String @id @default(cuid())
  adminId String
  admin   User   @relation(fields: [adminId], references: [id])
  shopId  String?
  shop    Shop?  @relation(fields: [shopId], references: [id], onDelete: SetNull)

  action   String
  reason   String?
  metadata Json?

  createdAt DateTime @default(now())

  @@index([shopId])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Content
// ---------------------------------------------------------------------------

// Small CMS-ish key/value store per shop -- contact details, delivery note,
// FAQ copy. Mirrors drip-crm's PageContent, which is the precedent for
// making shop identity data-driven rather than hardcoded in components.
model PageContent {
  id     String @id @default(cuid())
  shopId String
  shop   Shop   @relation(fields: [shopId], references: [id], onDelete: Cascade)
  key    String
  value  Json

  updatedAt DateTime @updatedAt

  @@unique([shopId, key])
}

/// A merchant-written content page (About, Delivery & returns, Contact, ...)
/// served at /pages/<slug>. body is plain text with a tiny markdown subset
/// (headings, bullets, **bold**, links) rendered by the storefront itself --
/// never raw HTML, so a page can't inject script into the shop.
model ShopPage {
  id           String  @id @default(cuid())
  shopId       String
  shop         Shop    @relation(fields: [shopId], references: [id], onDelete: Cascade)
  slug         String
  title        String
  body         String  @default("")
  published    Boolean @default(true)
  showInFooter Boolean @default(true)
  position     Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([shopId, slug])
}

// ---------------------------------------------------------------------------
// Platform-wide settings
// ---------------------------------------------------------------------------

/// A single-row table (id is always "singleton") rather than a key/value
/// store -- there is exactly one SMTP identity the platform sends system
/// email from (order confirmations, password resets, staff-invite
/// credentials), not one per shop; see this batch's own scoping note on why
/// that's deliberate. EmailService reads this row (falling back to
/// env vars if it's unset) instead of every call site touching Prisma
/// directly.
model PlatformSettings {
  id String @id @default("singleton")

  smtpHost     String?
  smtpPort     Int?
  smtpUser     String?
  smtpPassword String?
  smtpFrom     String?
  // STARTTLS (587) vs implicit TLS (465) -- nodemailer's `secure` option
  // needs this explicitly, since it can't be inferred from the port alone
  // for every provider.
  smtpSecure   Boolean @default(false)

  updatedAt DateTime @updatedAt
}
